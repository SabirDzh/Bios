DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bios?schema=public

# --- Приложение ---
# Порт HTTP (целое 1-65535).
PORT=3000

# CORS allowlist через запятую. В production обязателен (без него старт падает),
# в dev по умолчанию Vite + Tauri (включая origin собранного приложения).
# REQUIRED IN PRODUCTION
CORS_ORIGINS=http://localhost:5173,http://localhost:1420,http://tauri.localhost

# --- RSA-ключи для подписи JWT (RS256). Один из двух вариантов: ---
# 1) PEM прямо в env (переносы как реальные LF либо экранированные \n):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# 2) пути к PEM-файлам (закрытый PKCS#8/PKCS#1, открытый SPKI).
# В production отсутствие ключей роняет старт (эфемерные только в dev).
# REQUIRED IN PRODUCTION
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# TTL токенов в секундах (все с верхними границами, см. app.config.ts).
JWT_ACCESS_TTL_SEC=600
JWT_REFRESH_TTL_SEC=604800

# issuer/audience (по умолчанию bios / bios-api).
JWT_ISSUER=bios
JWT_AUDIENCE=bios-api

# Допуск рассинхрона часов в секундах.
JWT_CLOCK_TOLERANCE_SEC=5

# --- Куки ---
# Имена и path меняются редко; SameSite: lax|strict|none (none требует Secure).
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token
COOKIE_PATH=/
COOKIE_SAMESITE=lax
# Явный оверрайд Secure (true/false). По умолчанию: true только в production.
# COOKIE_SECURE=

# --- Rate limit (лимит/окно в мс) ---
THROTTLE_GLOBAL_LIMIT=120
THROTTLE_GLOBAL_TTL_MS=60000
THROTTLE_AUTH_STRICT_LIMIT=10
THROTTLE_AUTH_STRICT_TTL_MS=60000
THROTTLE_RECOVERY_LIMIT=5
THROTTLE_RECOVERY_TTL_MS=60000
THROTTLE_INVITE_LIMIT=30
THROTTLE_INVITE_TTL_MS=60000

# --- Почта ---
# Доп. заблокированные email-домены через запятую (плюс встроенный список
# одноразовых доменов из пакета disposable-email-domains).
EMAIL_EXTRA_BLOCKED_DOMAINS=
# Проверка MX-записей домена при регистрации (fail closed).
# Явное EMAIL_VERIFY_MX=false отключает (офлайн-разработка).
# EMAIL_VERIFY_MX=
# Таймаут DNS-запроса в мс.
EMAIL_MX_TIMEOUT_MS=3000

# --- Приглашения и одноразовые токены (секунды) ---
INVITATION_TTL_SEC=604800
TOKEN_CONFIRM_TTL_SEC=86400
TOKEN_RECOVERY_TTL_SEC=3600

# --- Обслуживание ---
# Cron чистки просроченных токенов и старых сессий + часовой пояс.
MAINTENANCE_CRON=0 3 * * *
MAINTENANCE_TIMEZONE=UTC
# Возраст неактивных сессий для удаления, дней.
MAINTENANCE_STALE_DAYS=30

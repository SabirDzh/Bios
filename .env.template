DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bios?schema=public

# RSA-ключи для подписи JWT (RS256). Нужен один из двух вариантов:
# 1) PEM прямо в env (переносы как реальные LF либо экранированные \n):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# 2) пути к PEM-файлам (закрытый PKCS#8/PKCS#1, открытый SPKI):
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# TTL токенов в секундах (по умолчанию 600 / 604800)
JWT_ACCESS_TTL_SEC=600
JWT_REFRESH_TTL_SEC=604800

# issuer/audience (по умолчанию bios / bios-api)
JWT_ISSUER=bios
JWT_AUDIENCE=bios-api

# Допуск рассинхрона часов в секундах (по умолчанию 5)
JWT_CLOCK_TOLERANCE_SEC=5

# CORS allowlist через запятую (по умолчанию Vite+Tauri dev-порты)
CORS_ORIGINS=http://localhost:5173,http://localhost:1420

# Доп. заблокированные email-домены через запятую (плюс встроенный список
# одноразовых доменов из пакета disposable-email-domains)
EMAIL_EXTRA_BLOCKED_DOMAINS=

# Строгая проверка MX-записей email-домена при регистрации (включена по
# умолчанию; fail closed — нет MX, DNS-ошибка или таймаут = отказ).
# Явное EMAIL_VERIFY_MX=false отключает (офлайн-разработка).
# EMAIL_VERIFY_MX=true
# Таймаут DNS-запроса в мс (по умолчанию 3000).
# EMAIL_MX_TIMEOUT_MS=3000

# --- Servers / SSH (часть 3 MVP) ---
# Активный AES-256 ключ (base64, 32 байта) для шифрования SSH-креденшелов серверов.
# В production обязателен. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Без него в non-production генерируется эфемерный: записи Server не переживут рестарт.
SERVER_CRYPTO_KEY=
SERVER_CRYPTO_KEY_ID=k1
# Ротация: старый ключ остаётся здесь (decrypt-only) до перевёртки cipher. Формат kid:base64.
SERVER_CRYPTO_OLD_KEYS=

# Таймауты SSH-операций в мс
SSH_CONNECT_TIMEOUT_MS=10000
SSH_COMMAND_TIMEOUT_MS=15000
SSH_INSTALL_TIMEOUT_MS=60000

# Политика сетевых целей: приватные диапазоны разрешены, link-local/metadata — нет.
SSH_ALLOWED_PORTS=22
# true — разрешить loopback (только dev и дымовой тест; в production запрещено).
SSH_ALLOW_LOOPBACK=false

# Версия агента панели и порог протухания heartbeat
AGENT_VERSION=0.1.0
AGENT_HEARTBEAT_STALE_SEC=60

# Лимит роутов test / agent/install / agent
THROTTLE_SSH_OPS_LIMIT=6
THROTTLE_SSH_OPS_TTL_MS=60000

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid(7))
  username        String           @unique
  email           String           @unique
  password        String
  confirmed       Boolean          @default(false)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  tokens          Token[]
  refreshSessions RefreshSession[]
  members         WorkspaceMember[]
  sentInvitations WorkspaceInvitation[] @relation("SentInvitations")
}

model Token {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, type])
  @@index([expiresAt])
}

model RefreshSession {
  id        String               @id @default(uuid(7))
  jti       String               @unique
  familyId  String
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  status    RefreshSessionStatus @default(ACTIVE)
  expiresAt DateTime             @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  usedAt    DateTime?            @db.Timestamptz(3)
  revokedAt DateTime?            @db.Timestamptz(3)

  @@index([familyId, status])
  @@index([userId, status])
}

enum TokenType {
  CONFIRM
  RECOVERY
}

enum RefreshSessionStatus {
  ACTIVE
  USED
  REVOKED
}

model Workspace {
  id          String               @id @default(uuid(7))
  name        String
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  servers     Server[]
}

model WorkspaceMember {
  id          String        @id @default(uuid(7))
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String           @id @default(uuid(7))
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime         @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, status])
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Server {
  id               String            @id @default(uuid(7))
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  host             String
  port             Int               @default(22)
  sshUsername      String
  authType         ServerAuthType
  secretCipher     String
  /// Принятый пользователем SHA256-отпечаток host key. NULL = ключ хоста ещё не подтверждён.
  hostKeyFingerprint String?
  /// Только доступность SSH-хоста; про Docker и агента — lastAgentStatus/lastAgentErrorCode.
  status           ServerStatus        @default(PENDING)
  dockerVersion    String?
  agentVersion     String?
  agentInstalledAt DateTime?           @db.Timestamptz(3)
  lastAgentStatus  AgentReportStatus?
  lastAgentErrorCode String?
  lastCheckedAt    DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([workspaceId, name])
  @@unique([workspaceId, hostKeyFingerprint])
  @@index([workspaceId])
}

enum ServerStatus {
  PENDING
  ONLINE
  OFFLINE
}

enum ServerAuthType {
  PASSWORD
  KEY
}

enum AgentReportStatus {
  NOT_INSTALLED
  FAILED
  STALE
  ACTIVE
}
